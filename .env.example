# Copy to .env.production (Docker) or server/.env (local). Never commit the real file.

PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5000

# Inside Docker Compose the database host is the service name "mongodb".
# Locally without Docker use: mongodb://localhost:27017/serendibgo
MONGODB_URI=mongodb://admin:password@mongodb:27017/serendibgo?authSource=admin

JWT_SECRET=change-me
JWT_EXPIRE=7d

# Stripe test keys only
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

GEMINI_API_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
